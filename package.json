{
  "name": "prepilo",
  "private": false,
  "version": "1.0.0",
  "description": "Prepilo — desktop interview prep (Electron study app + GTK lock)",
  "author": {
    "name": "Prepilo",
    "email": "prepilo@users.noreply.github.com"
  },
  "desktopName": "prepilo.desktop",
  "license": "MIT",
  "homepage": "https://github.com/souravs72/prepilo",
  "repository": {
    "type": "git",
    "url": "https://github.com/souravs72/prepilo.git"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n web,runner -c teal,yellow \"vite\" \"node server/runner.mjs\"",
    "dev:web": "vite",
    "runner": "node server/runner.mjs",
    "electron": "electron electron/main.mjs",
    "electron:dev": "concurrently -k -n web,runner,app -c teal,yellow,magenta \"vite\" \"node server/runner.mjs\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:4789/health && electron electron/main.mjs\"",
    "electron:prod": "npm run build && PREPILO_ELECTRON_PROD=1 electron electron/main.mjs",
    "app": "electron/prepilo-app",
    "lock": "desktop/prepilo-lock",
    "show-bypass": "desktop/show-bypass.sh",
    "rotate-bypass": "desktop/rotate-bypass.sh",
    "install-lock": "desktop/install-lock.sh",
    "install-app": "electron/install-app.sh",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:dir": "npm run build && electron-builder --linux dir --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.prepilo.app",
    "productName": "Prepilo",
    "copyright": "Copyright © Prepilo",
    "directories": {
      "output": "release",
      "buildResources": "electron/icons"
    },
    "files": [
      "dist/**/*",
      "electron/main.mjs",
      "electron/preload.cjs",
      "electron/icons/**/*",
      "server/runner.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop",
        "to": "desktop",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "electron/icons/icon.png",
      "synopsis": "Interview prep study desk with optional GTK session lock",
      "description": "Prepilo helps you practice DSA, system design, OS, and DBMS with daily sets, mocks, and analytics. Includes an optional Ubuntu GTK lock that gates login/logout behind a question."
    },
    "appImage": {
      "artifactName": "Prepilo-${version}-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "prepilo_${version}_amd64.deb",
      "maintainer": "Prepilo <prepilo@users.noreply.github.com>",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
