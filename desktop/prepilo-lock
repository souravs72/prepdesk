#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
cd "$ROOT"

# Same React Lock UI as the browser. Prefer XWayland (avoids Wayland Error 11).
if [[ -n "${PREPILO_GDK_BACKEND:-}" ]]; then
  export GDK_BACKEND="$PREPILO_GDK_BACKEND"
else
  export GDK_BACKEND=x11
fi

export PREPILO_URL="${PREPILO_URL:-http://127.0.0.1:5173/lock}"
# Pure GTK fallback (no WebKit): PREPILO_LOCK_UI=native prepilo-lock
if [[ "${PREPILO_LOCK_UI:-webkit}" == "native" ]]; then
  exec /usr/bin/python3 "$ROOT/desktop/native_lock.py" "$@"
fi
exec /usr/bin/python3 "$ROOT/desktop/lock_shell.py" "$@"
